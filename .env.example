# Copy to .env for local dev. Never commit the real .env.
#
# Your Home Assistant URL. The probe script auto-derives the websocket URL
# from this (http → ws, https → wss) and appends /api/websocket.
HA_URL=http://homeassistant.local:8123

# Long-lived access token from HA: profile → Security → Long-lived access tokens.
HA_TOKEN=

# Optional log level for dev scripts.
MYLO_LOG_LEVEL=INFO

# Where Mylo reads/writes local files. In production (HA add-on) this is
# always /config/. For dev on your own machine, point it somewhere writable.
# The directory is auto-created on first use of memory_note / read_config_file.
MYLO_CONFIG_DIR=./dev-config
