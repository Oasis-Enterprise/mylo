# Copy to .env for local dev. Never commit the real .env.
#
# Your Home Assistant URL. The probe script auto-derives the websocket URL
# from this (http → ws, https → wss) and appends /api/websocket.
HA_URL=http://homeassistant.local:8123

# Long-lived access token from HA: profile → Security → Long-lived access tokens.
HA_TOKEN=

# Optional log level for dev scripts.
MYLO_LOG_LEVEL=INFO
